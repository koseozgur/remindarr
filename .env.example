# Copy to .env and fill in. A platform is enabled by having a token --
# there is no separate on/off switch to fall out of sync with the credential.

# --- Platforms (at least one required) -------------------------------------

# @BotFather -> /newbot
REMINDARR_TELEGRAM_TOKEN=

# discord.com/developers -> your app -> Bot -> Reset Token
# NOTE: also enable Bot -> Privileged Gateway Intents -> MESSAGE CONTENT INTENT,
# or the bot connects fine and then sees every message as blank.
REMINDARR_DISCORD_TOKEN=

# LINE needs BOTH of these (or neither). Setting just one is a startup error.
# developers.line.biz/console -> your Messaging API channel:
#   Basic settings -> Channel secret
REMINDARR_LINE_CHANNEL_SECRET=
#   Messaging API -> Channel access token (long-lived)
REMINDARR_LINE_CHANNEL_ACCESS_TOKEN=

# --- Access control ---------------------------------------------------------
# Who may use the bot. Deny by default: empty means NOBODY, you included.
# Message the bot once and it replies with your id in exactly this format.
# Comma-separated platform:user_id; platform is telegram, discord or line.
#   REMINDARR_ALLOWED_USERS=line:U4af49806..., telegram:123456789
REMINDARR_ALLOWED_USERS=

# --- LINE webhook -----------------------------------------------------------
# LINE pushes messages to a webhook, so enabling it opens an inbound port.
# LINE must reach it over public HTTPS (reverse proxy, tunnel, ...). The
# console's Webhook URL is https://<your host><REMINDARR_LINE_WEBHOOK_PATH>.

REMINDARR_WEBHOOK_HOST=0.0.0.0
REMINDARR_WEBHOOK_PORT=8080
REMINDARR_LINE_WEBHOOK_PATH=/line/webhook

# --- Behaviour --------------------------------------------------------------

# IANA name. Applied to subscribers who have not run /tz themselves.
REMINDARR_DEFAULT_TIMEZONE=Asia/Tokyo

# Under Docker this should be an absolute path (four slashes after the scheme):
#   sqlite+aiosqlite:////data/remindarr.db
REMINDARR_DATABASE_URL=sqlite+aiosqlite:///data/remindarr.db

# How often to look for due reminders. Lower is more precise and more wakeups.
REMINDARR_TICK_SECONDS=15

REMINDARR_MAX_DELIVERY_ATTEMPTS=5
REMINDARR_RETRY_BACKOFF_SECONDS=30

# How late a reminder may be before the message admits it is late.
REMINDARR_LATE_DELIVERY_GRACE_MINUTES=60

# --- Logging ----------------------------------------------------------------

REMINDARR_LOG_LEVEL=INFO
REMINDARR_LOG_JSON=false
